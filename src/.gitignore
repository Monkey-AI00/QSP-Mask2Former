# ===== Logs =====
*.log

# ===== Model weights / large binaries (GitHub 单文件限制 100MB) =====
*.pth
*.pt
*.pkl
*.onnx
*.engine
detectron2/weights/
detectron2/cleargrasp/cleargrasp-checkpoints/

# ===== Generated outputs =====
detectron2/projects/PointRend/output/
detectron2/projects/PointRend/output_live/
detectron2/projects/PointRend/output_inference/
ultralytics/runs/
ultralytics/runs/**/*

# ===== Large point cloud / depth outputs (通常是生成物) =====
**/*.ply
**/*.pcd
**/*.tiff
**/*.tif

# ===== Nested git repos protection (should not be committed) =====
**/.git/


