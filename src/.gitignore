# ===== Python / cache =====
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ===== Build artifacts =====
build/
dist/
detectron2/build/
